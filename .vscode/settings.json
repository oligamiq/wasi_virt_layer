{
    "rust-analyzer.linkedProjects": [
        "${workspaceFolder}/Cargo.toml",
    ],
    // "rust-analyzer.cargo.target": "wasm32-wasip1-threads",
    "rust-analyzer.cargo.features": [
        "threads"
    ],
    "files.useExperimentalFileWatcher": false,
    "files.usePolling": true,
    "files.watcherExclude": {
        "**/node_modules/**": true,
        "**/.git/**": true,
        "**/dist/**": true,
        "**/build/**": true
    },
    "cSpell.words": [
        "atim",
        "BADF",
        "camino",
        "Ciovec",
        "CREAT",
        "ctim",
        "dashmap",
        "Deque",
        "Dircookie",
        "dirflags",
        "environc",
        "Errno",
        "EVENTTYPE",
        "ewrite",
        "Exitcode",
        "Fdflags",
        "fdstat",
        "Filesize",
        "Filestat",
        "funcs",
        "heapless",
        "includer",
        "instrs",
        "iovec",
        "iovs",
        "ISDIR",
        "Itertools",
        "Linkcount",
        "lookupflags",
        "mtim",
        "namlen",
        "nlink",
        "NOENT",
        "nonoverlapping",
        "NOSYS",
        "NOTDIR",
        "NOTSUP",
        "nread",
        "nsubscriptions",
        "nwritten",
        "Oflags",
        "oneoff",
        "Pread",
        "Prestat",
        "pwrite",
        "readlink",
        "repr",
        "sched",
        "Subclockflags",
        "TRUNC",
        "Uninit",
        "wasi",
        "Wasip",
        "wasip1"
    ]
}
